{"fps": 30, "total_frames": 1822, "engine": "edge", "voice": "en-US-AndrewNeural", "rate": "+0%", "gap": 10, "para_gap": 20, "chapter_gap": 45, "lead": 40, "tail": 90, "lang": "en", "chapters": [], "sentences": [{"id": "S01", "chapter": 0, "from": 41, "to": 187, "text": "Your voice and your photos ride the same wire — under two different sets of rules.", "para": true, "subs": [{"from": 41, "to": 81, "text": "Your voice and your photos"}, {"from": 82, "to": 126, "text": "ride the same wire —"}, {"from": 127, "to": 187, "text": "under two different sets of rules."}]}, {"id": "S02", "chapter": 0, "from": 218, "to": 316, "text": "Everything you send becomes packets — envelopes of data.", "para": false, "subs": [{"from": 218, "to": 283, "text": "Everything you send becomes packets —"}, {"from": 284, "to": 316, "text": "envelopes of data."}]}, {"id": "S03", "chapter": 0, "from": 327, "to": 423, "text": "And the network underneath, IP, promises nothing.", "para": false, "subs": [{"from": 327, "to": 392, "text": "And the network underneath, IP,"}, {"from": 393, "to": 423, "text": "promises nothing."}]}, {"id": "S04", "chapter": 0, "from": 434, "to": 526, "text": "No receipts. No retries. No order.", "para": true, "subs": [{"from": 434, "to": 526, "text": "No receipts. No retries. No order."}]}, {"id": "S05", "chapter": 0, "from": 557, "to": 638, "text": "So your photo rides TCP — the courier.", "para": false, "subs": [{"from": 557, "to": 638, "text": "So your photo rides TCP — the courier."}]}, {"id": "S06", "chapter": 0, "from": 649, "to": 772, "text": "First, a handshake: SYN. SYN-ACK. ACK.", "para": false, "subs": [{"from": 649, "to": 691, "text": "First, a handshake:"}, {"from": 692, "to": 772, "text": "SYN. SYN-ACK. ACK."}]}, {"id": "S07", "chapter": 0, "from": 783, "to": 866, "text": "Every envelope numbered, every number receipted.", "para": false, "subs": [{"from": 783, "to": 830, "text": "Every envelope numbered,"}, {"from": 831, "to": 866, "text": "every number receipted."}]}, {"id": "S08", "chapter": 0, "from": 877, "to": 981, "text": "Lost in transit? Sent again — on a timer that doubles.", "para": true, "subs": [{"from": 877, "to": 939, "text": "Lost in transit? Sent again —"}, {"from": 940, "to": 981, "text": "on a timer that doubles."}]}, {"id": "S09", "chapter": 0, "from": 1024, "to": 1099, "text": "Your voice rides UDP — the postcard.", "para": false, "subs": [{"from": 1024, "to": 1099, "text": "Your voice rides UDP — the postcard."}]}, {"id": "S10", "chapter": 0, "from": 1110, "to": 1209, "text": "No handshake. No receipts. Eight bytes of header.", "para": false, "subs": [{"from": 1110, "to": 1178, "text": "No handshake. No receipts."}, {"from": 1179, "to": 1209, "text": "Eight bytes of header."}]}, {"id": "S11", "chapter": 0, "from": 1220, "to": 1343, "text": "A late packet is a dead packet — the call plays a gap, and moves on.", "para": true, "subs": [{"from": 1220, "to": 1277, "text": "A late packet is a dead packet —"}, {"from": 1278, "to": 1343, "text": "the call plays a gap, and moves on."}]}, {"id": "S12", "chapter": 0, "from": 1384, "to": 1489, "text": "Plot twist: the newest HTTP rides UDP.", "para": false, "subs": [{"from": 1384, "to": 1489, "text": "Plot twist: the newest HTTP rides UDP."}]}, {"id": "S13", "chapter": 0, "from": 1500, "to": 1642, "text": "QUIC rebuilt TCP's promises above the wire, where apps can evolve.", "para": true, "subs": [{"from": 1500, "to": 1570, "text": "QUIC rebuilt TCP's promises"}, {"from": 1571, "to": 1605, "text": "above the wire,"}, {"from": 1606, "to": 1642, "text": "where apps can evolve."}]}, {"id": "S14", "chapter": 0, "from": 1685, "to": 1730, "text": "TCP never loses.", "para": false, "subs": [{"from": 1685, "to": 1730, "text": "TCP never loses."}]}, {"id": "S15", "chapter": 0, "from": 1741, "to": 1782, "text": "UDP never waits.", "para": true, "subs": [{"from": 1741, "to": 1782, "text": "UDP never waits."}]}], "chars": 542, "words": 124, "speech_sec": 48.92}