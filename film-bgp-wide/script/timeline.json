  },
  {
   "id": "S08",
   "chapter": 2,
   "from": 1073,
   "to": 1196,
   "text": "Each has a number, and speaks for its own corner of the map — a diplomat.",
   "para": false,
   "subs": [
    {
     "from": 1073,
