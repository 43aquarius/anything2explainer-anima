    }
   ]
  },
  {
   "id": "S10",
   "chapter": 2,
   "from": 1326,
   "to": 1444,
   "text": "\"I can reach this address block, through these networks.\" Pass it on.",
   "para": false,
   "subs": [
    {
     "from": 1326,
     "to": 1377,
     "text": "\"I can reach this address block,"
    },
