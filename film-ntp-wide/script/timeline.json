    }
   ]
  },
  {
   "id": "S07",
   "chapter": 1,
   "from": 676,
   "to": 787,
   "text": "A database told the same thing writes it down in a different order.",
   "para": false,
   "subs": [
    {
     "from": 676,
     "to": 730,
     "text": "A database told the same thing"
    },
    {
     "from": 731,
     "to": 787,
