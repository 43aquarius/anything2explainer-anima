  },
  {
   "id": "S20",
   "chapter": 3,
   "from": 2172,
   "to": 2253,
   "text": "The trick: trust the ones that agree with each other.",
   "para": false,
   "subs": [
    {
     "from": 2172,
     "to": 2217,
     "text": "The trick: trust the ones"
    },
    {
     "from": 2218,
