    },
    {
     "from": 1779,
     "to": 1840,
     "text": "and so on, down to fifteen."
    }
   ]
  },
  {
   "id": "S17",
   "chapter": 3,
   "from": 1916,
   "to": 2002,
   "text": "But networks lie a little. Every answer arrives late.",
   "para": false,
   "subs": [
    {
     "from": 1916,
     "to": 1958,
     "text": "But networks lie a little."
    },
    {
     "from": 1959,
