   ]
  },
  {
   "id": "S02",
   "chapter": 1,
   "from": 151,
   "to": 265,
   "text": "Not broken — just drifting. A quartz crystal counts the seconds,",
   "para": false,
   "subs": [
    {
     "from": 151,
     "to": 204,
     "text": "Not broken — just drifting."
    },
    {
     "from": 205,
