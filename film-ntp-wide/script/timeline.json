     "text": "For the internet, it's a problem."
    }
   ]
  },
  {
   "id": "S05",
   "chapter": 1,
   "from": 480,
   "to": 552,
   "text": "Login codes expire in thirty seconds.",
   "para": false,
   "subs": [
    {
     "from": 480,
     "to": 552,
     "text": "Login codes expire in thirty seconds."
    }
   ]
  },
  {
   "id": "S06",
   "chapter": 1,
   "from": 563,
   "to": 665,
   "text": "Certificates are valid only between two exact moments.",
   "para": false,
   "subs": [
    {
     "from": 563,
     "to": 601,
     "text": "Certificates are valid"
    },
    {
     "from": 602,
