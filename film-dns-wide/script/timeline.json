  {
   "id": "S47",
   "chapter": 4,
   "from": 6882,
   "to": 7083,
   "text": "For 19 days in 2003, every mistyped .com name on Earth landed on one company's ad page.",
   "para": false,
   "subs": [
    {
     "from": 6882,
     "to": 6950,
     "text": "For 19 days in 2003,"
