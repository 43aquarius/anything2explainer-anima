  {
   "id": "S02",
   "chapter": 1,
   "from": 238,
   "to": 374,
   "text": "Here is the strange part: no machine on the internet is named shop.example.",
   "para": false,
   "subs": [
    {
     "from": 238,
     "to": 283,
     "text": "Here is the strange part:"
    },
    {
     "from": 284,
