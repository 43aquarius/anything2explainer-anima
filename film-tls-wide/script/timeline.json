     "from": 4904,
     "to": 4975,
     "text": "HTTPS stopped being a luxury."
    }
   ]
  },
  {
   "id": "S33",
   "chapter": 4,
   "from": 5021,
   "to": 5204,
   "text": "Today, more than four out of five page loads travel over TLS. The little lock is just... normal.",
   "para": false,
   "subs": [
    {
     "from": 5021,
     "to": 5075,
     "text": "Today, more than four out of five"
    },
