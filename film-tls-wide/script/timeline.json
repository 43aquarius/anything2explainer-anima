    }
   ]
  },
  {
   "id": "S11",
   "chapter": 2,
   "from": 1546,
   "to": 1666,
   "text": "Under the lock, the first move is a handshake that takes a single round trip.",
   "para": false,
   "subs": [
    {
     "from": 1546,
     "to": 1593,
     "text": "Under the lock, the first move"
    },
    {
     "from": 1594,
     "to": 1666,
     "text": "is a handshake that takes a single round trip."
    }
   ]
  },
  {
   "id": "S12",
   "chapter": 2,
   "from": 1677,
   "to": 1808,
   "text": "Your browser sends a ClientHello — its list of ciphers and a key-share.",
   "para": false,
   "subs": [
    {
     "from": 1677,
     "to": 1736,
     "text": "Your browser sends a ClientHello —"
    },
    {
     "from": 1737,
     "to": 1808,
     "text": "its list of ciphers and a key-share."
    }
   ]
  },
  {
   "id": "S13",
   "chapter": 2,
   "from": 1819,
   "to": 1911,
   "text": "The server answers with its own hello and its certificate.",
   "para": false,
   "subs": [
    {
     "from": 1819,
     "to": 1880,
     "text": "The server answers with its own hello"
    },
    {
     "from": 1881,
