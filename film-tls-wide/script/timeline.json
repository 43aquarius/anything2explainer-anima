  {
   "id": "S19",
   "chapter": 3,
   "from": 2747,
   "to": 2866,
   "text": "How do two strangers agree on a secret on a channel everyone can read?",
   "para": false,
   "subs": [
    {
     "from": 2747,
     "to": 2810,
     "text": "How do two strangers agree on a secret"
    },
    {
     "from": 2811,
     "to": 2866,
     "text": "on a channel everyone can read?"
    }
   ]
  },
  {
   "id": "S20",
   "chapter": 3,
   "from": 2877,
   "to": 3033,
   "text": "This is the Diffie-Hellman trick, published in 1976 — fifty years ago.",
   "para": false,
   "subs": [
    {
     "from": 2877,
     "to": 2935,
     "text": "This is the Diffie-Hellman trick,"
    },
    {
     "from": 2936,
     "to": 3000,
     "text": "published in 1976 —"
    },
    {
     "from": 3001,
     "to": 3033,
     "text": "fifty years ago."
    }
   ]
  },
  {
   "id": "S21",
   "chapter": 3,
   "from": 3044,
   "to": 3138,
   "text": "Each side mixes a private color into a public one.",
   "para": false,
   "subs": [
    {
     "from": 3044,
     "to": 3105,
     "text": "Each side mixes a private color"
    },
    {
     "from": 3106,
     "to": 3138,
     "text": "into a public one."
    }
   ]
  },
  {
   "id": "S22",
   "chapter": 3,
   "from": 3149,
   "to": 3248,
   "text": "Anyone watching sees the mixes — and cannot un-mix them.",
   "para": false,
   "subs": [
    {
     "from": 3149,
     "to": 3209,
     "text": "Anyone watching sees the mixes —"
    },
    {
     "from": 3210,
     "to": 3248,
     "text": "and cannot un-mix them."
    }
   ]
  },
  {
   "id": "S23",
   "chapter": 3,
   "from": 3259,
   "to": 3422,
   "text": "The math version relies on one-way doors: multiplying is easy, undoing it is not.",
   "para": true,
   "subs": [
    {
     "from": 3259,
     "to": 3281,
     "text": "The math version"
    },
    {
     "from": 3282,
     "to": 3336,
     "text": "relies on one-way doors:"
    },
    {
     "from": 3337,
     "to": 3381,
     "text": "multiplying is easy,"
    },
    {
     "from": 3382,
     "to": 3422,
     "text": "undoing it is not."
    }
   ]
  },
  {
   "id": "S24",
   "chapter": 3,
   "from": 3468,
   "to": 3592,
   "text": "That gives TLS a property worth saying out loud: forward secrecy.",
   "para": false,
   "subs": [
    {
     "from": 3468,
     "to": 3515,
     "text": "That gives TLS a property"
    },
    {
     "from": 3516,
     "to": 3561,
     "text": "worth saying out loud:"
    },
    {
     "from": 3562,
     "to": 3592,
     "text": "forward secrecy."
    }
   ]
  },
  {
   "id": "S25",
   "chapter": 3,
   "from": 3603,
   "to": 3781,
   "text": "If the server's private key is stolen tomorrow, the recordings from yesterday still cannot be decrypted.",
   "para": false,
   "subs": [
    {
     "from": 3603,
     "to": 3648,
     "text": "If the server's private key"
    },
    {
     "from": 3649,
     "to": 3689,
     "text": "is stolen tomorrow,"
    },
    {
     "from": 3690,
     "to": 3732,
     "text": "the recordings from yesterday"
    },
    {
     "from": 3733,
     "to": 3781,
     "text": "still cannot be decrypted."
    }
   ]
  },
  {
   "id": "S26",
   "chapter": 3,
   "from": 3792,
   "to": 3827,
   "text": "The past stays sealed.",
   "para": false,
   "subs": [
    {
     "from": 3792,
     "to": 3827,
     "text": "The past stays sealed."
    }
   ]
  },
  {
   "id": "S27",
   "chapter": 3,
   "from": 3838,
   "to": 4091,
   "text": "TLS 1.3 makes this mandatory. No exceptions, no weak suites — five cipher suites, down from thirty-one.",
   "para": true,
   "subs": [
    {
     "from": 3838,
     "to": 3933,
     "text": "TLS 1.3 makes this mandatory."
    },
    {
     "from": 3934,
     "to": 4008,
