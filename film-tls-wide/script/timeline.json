     "from": 4690,
     "to": 4748,
     "text": "by anyone your browser believes."
    }
   ]
  },
  {
   "id": "S32",
   "chapter": 4,
   "from": 4759,
   "to": 4975,
   "text": "In 2015, Let's Encrypt made certificates free and automatic. HTTPS stopped being a luxury.",
   "para": true,
   "subs": [
    {
     "from": 4759,
     "to": 4823,
     "text": "In 2015, Let's Encrypt"
    },
    {
     "from": 4824,
