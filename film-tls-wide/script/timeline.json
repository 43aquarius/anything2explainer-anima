     "text": "symmetric encryption, AES-GCM."
    },
    {
     "from": 2287,
     "to": 2341,
     "text": "Fast, stream-like, sealed."
    }
   ]
  },
  {
   "id": "S16",
   "chapter": 2,
   "from": 2352,
   "to": 2442,
   "text": "The person at the next table still sees every packet.",
   "para": false,
   "subs": [
