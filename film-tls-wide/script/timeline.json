   ]
  },
  {
   "id": "S08",
   "chapter": 1,
   "from": 1131,
   "to": 1217,
   "text": "Their answer was SSL — a lock on the envelope.",
   "para": false,
   "subs": [
    {
     "from": 1131,
     "to": 1180,
     "text": "Their answer was SSL —"
    },
