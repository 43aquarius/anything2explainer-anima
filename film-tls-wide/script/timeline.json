  },
  {
   "id": "S30",
   "chapter": 4,
   "from": 4397,
   "to": 4560,
   "text": "Your browser ships with about a hundred and twenty of these authorities built in. Trust, pre-installed.",
   "para": false,
   "subs": [
    {
     "from": 4397,
     "to": 4429,
     "text": "Your browser ships with"
